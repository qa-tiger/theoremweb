# Supabase Configuration
# Replace these values with your project credentials from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Storage Buckets
# Default bucket name for free PDF e-books is 'ebooks'
VITE_SUPABASE_EBOOKS_BUCKET=ebooks

# Bucket name for Indian user Aadhaar / PAN KYC documents
VITE_SUPABASE_KYC_BUCKET=kyc-documents

